# Used by docker-compose.yml (copy to .env). Local (non-Docker) development uses backend/.env instead.
JWT_SECRET=replace-with-a-long-random-secret
ZALO_BRIDGE_SECRET=replace-with-another-long-random-secret
# Zalo OA webhook (POST /api/v1/webhooks/zalo): not served at all while this is empty. When set, put it in the webhook
# URL registered at Zalo (https://<domain>/api/v1/webhooks/zalo?secret=<this value>) or send it as X-Webhook-Secret.
ZALO_WEBHOOK_SECRET=

ZALO_OA_ACCESS_TOKEN=
ZALO_PERSONAL_COOKIE=
ZALO_PERSONAL_IMEI=
ZALO_PERSONAL_USER_AGENT=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

JT_API_ACCOUNT=
JT_PRIVATE_KEY=
JT_CUSTOMER_CODE=

# Browser-visible URL of the API (baked into the frontend bundle at build time)
VITE_API_URL=http://localhost:5000/api/v1
