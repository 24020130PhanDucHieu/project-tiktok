NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/tiktoday_booking
FRONTEND_URL=http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
ZALO_OA_ACCESS_TOKEN=replace-with-zalo-oa-access-token
# JSON array exported from Zalo Web cookie editor. Never commit real credentials.
ZALO_PERSONAL_COOKIE=[]
ZALO_PERSONAL_IMEI=replace-with-zalo-imei
ZALO_PERSONAL_USER_AGENT=replace-with-browser-user-agent
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=Tiktoday <your-smtp-user>
