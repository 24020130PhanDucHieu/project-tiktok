APP_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/tiktoday_booking
FRONTEND_URL=http://127.0.0.1:5173

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# --- Accounts ---
# First admin, created on first start when no admin exists (change the password after signing in)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe12345
# Public self-registration is OFF; admins create accounts in the Users page
ALLOW_REGISTRATION=false
PASSWORD_RESET_TTL=10m

# --- Zalo ---
ZALO_OA_ACCESS_TOKEN=replace-with-zalo-oa-access-token
# Personal account (sent through the zalo-bridge sidecar). Cookie is the JSON array exported from Zalo Web. Never commit real credentials.
ZALO_PERSONAL_COOKIE=[]
ZALO_PERSONAL_IMEI=replace-with-zalo-imei
ZALO_PERSONAL_USER_AGENT=replace-with-browser-user-agent
ZALO_BRIDGE_URL=http://127.0.0.1:5100
ZALO_BRIDGE_SECRET=development-bridge-secret

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=Tiktoday <your-smtp-user>

# --- J&T Express Open Platform (optional, public tracking page is used otherwise) ---
JT_API_URL=https://openapi.jtexpress.vn/webopenplatformapi/api
JT_API_ACCOUNT=
JT_PRIVATE_KEY=
JT_CUSTOMER_CODE=

# Gmail OAuth (inbox email). Create an OAuth client in Google Cloud, enable the Gmail API,
# add the redirect URL below, and add the scopes gmail.send, gmail.readonly, userinfo.email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://127.0.0.1:5000/api/v1/gmail/callback
